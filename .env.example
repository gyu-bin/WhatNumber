# 배포 도메인 (상세 링크 공유 URL에 사용)
VITE_SITE_URL=https://whatnumber-mu.vercel.app

# 번호 요청 / 피드백 API (미설정 시 같은 도메인의 /api/number-request)
# VITE_NUMBER_REQUEST_API_URL=https://whatnumber-mu.vercel.app/api/number-request

# Vercel 서버 전용 (앱/웹 번들에 넣지 마세요)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=몇번이야 <noreply@your-verified-domain.com>
# NUMBER_REQUEST_TO_EMAIL=you@example.com
# NEMC_EMERGENCY_API_KEY=공공데이터포털_응급실_서비스키

# AdSense 게시자 ID (계정 → 계정 정보 → pub-xxxxxxxxxxxxxxxx)
# npm run generate-ads-txt 로 public/ads.txt 생성
VITE_ADSENSE_PUBLISHER_ID=pub-2202662035854210
# VITE_ADSENSE_CLIENT_ID=ca-pub-2202662035854210

# 모바일 앱 (apps/mobile/.env)
# EXPO_PUBLIC_EMERGENCY_API_BASE_URL=https://whatnumber-mu.vercel.app/api/emergency
# EXPO_PUBLIC_NUMBER_REQUEST_API_URL=https://whatnumber-mu.vercel.app/api/number-request
# ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
# ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
# EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
