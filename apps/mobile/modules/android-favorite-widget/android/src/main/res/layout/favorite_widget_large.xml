    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
      android:id="@+id/phone_3"
      android:layout_width="96dp"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/widget_text"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/title_3"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/widget_text_secondary"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/call_3"
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:background="@drawable/widget_call_bg"
      android:gravity="center"
      android:text="@string/favorite_widget_call"
      android:textColor="@color/widget_accent"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
      android:id="@+id/phone_4"
      android:layout_width="96dp"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/widget_text"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/title_4"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/widget_text_secondary"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/call_4"
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:background="@drawable/widget_call_bg"
      android:gravity="center"
      android:text="@string/favorite_widget_call"
      android:textColor="@color/widget_accent"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/row_5"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="3dp"
