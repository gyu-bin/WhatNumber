{
  "name": "mobile",
  "version": "1.0.1",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "EXPO_NO_UPDATES=1 expo start --go",
    "start:dev-client": "expo start",
    "start:go": "EXPO_NO_UPDATES=1 expo start --go",
    "android": "EXPO_NO_UPDATES=1 expo start --android --go",
    "ios": "EXPO_NO_UPDATES=1 expo start --ios --go",
    "web": "EXPO_NO_UPDATES=1 expo start --web",
    "prebuild": "expo prebuild",
    "lint:types": "tsc --noEmit",
    "eas:build:dev": "eas build --profile development",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:prod": "eas build --profile production",
    "eas:update:preview": "eas update --channel preview --environment preview",
    "eas:update:prod": "eas update --channel production --environment production",
    "eas:submit": "eas submit --profile production",
    "eas:configure": "eas build:configure && eas update:configure"
  },
  "dependencies": {
    "@expo/ui": "~56.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@mj-studio/react-native-naver-map": "^2.9.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@whatnumber/shared": "*",
    "expo": "~56.0.21",
    "expo-build-properties": "~56.0.27",
    "expo-constants": "~56.0.25",
    "expo-dev-client": "~56.0.19",
    "expo-device": "~56.0.4",
    "expo-localization": "^57.0.2",
    "expo-location": "~56.0.25",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.18",
    "expo-widgets": "~56.0.19",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.85.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "16.3.4",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
